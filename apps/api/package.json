{
  "name": "@mealmind/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/server.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:products:db": "tsx src/modules/product/infrastructure/prisma-product-repository.integration.ts",
    "test:accounts:db": "tsx src/modules/account/infrastructure/prisma-account-repository.integration.ts",
    "test:families:db": "tsx src/modules/family/infrastructure/prisma-family-repository.integration.ts",
    "test:recipes:db": "tsx src/modules/recipe/infrastructure/prisma-recipe-repository.integration.ts",
    "test:coverage": "vitest run --coverage",
    "openapi:export": "tsx src/scripts/export-openapi.ts",
    "openapi:check": "tsx src/scripts/export-openapi.ts --check",
    "openapi:watch": "tsx watch --clear-screen=false src/scripts/export-openapi.ts",
    "media:cleanup": "tsx src/modules/product/scripts/cleanup-orphaned-media.ts"
  },
  "dependencies": {
    "@mealmind/db": "0.0.0",
    "@mealmind/observability": "0.0.0",
    "@sentry/node": "10.68.0",
    "@supabase/supabase-js": "2.110.9",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-rate-limit": "8.6.1",
    "pino": "10.3.1",
    "resend": "^6.19.0",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.1.2",
    "@types/supertest": "7.2.1",
    "prettier": "3.9.6",
    "supertest": "7.2.2",
    "tsx": "4.23.1"
  }
}
