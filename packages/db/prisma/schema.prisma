  position   Int      @db.SmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  mealPlan                MealPlan                 @relation(fields: [mealPlanId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mealType                MealType                 @relation(fields: [mealTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipe                  Recipe?                  @relation(fields: [recipeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product                 Product?                 @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
