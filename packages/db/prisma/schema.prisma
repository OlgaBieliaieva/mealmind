//------------------ USER --------------------------

model User {
  id                    String          @id @default(uuid()) @db.Uuid
  externalSubject       String          @unique @map("external_subject") @db.Uuid
  email                 String          @unique @db.VarChar(320)
  applicationRole       ApplicationRole @default(USER) @map("application_role")
  onboardingCompletedAt DateTime?       @map("onboarding_completed_at") @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt             DateTime?       @map("deleted_at") @db.Timestamptz(3)

  personProfile              PersonProfile?
  memberships                FamilyMembership[]
  familiesCreated            Family[]                    @relation("FamilyCreator")
  uploadedProductMedia       ProductMedia[]              @relation("ProductMediaUploader")
  assignedProductDietaryTags ProductDietaryTag[]         @relation("ProductDietaryTagAssigner")
  verifiedProductDietaryTags ProductDietaryTag[]         @relation("ProductDietaryTagVerifier")
  assignedProductAllergens   ProductAllergen[]           @relation("ProductAllergenAssigner")
  verifiedProductAllergens   ProductAllergen[]           @relation("ProductAllergenVerifier")
  createdRecipes             Recipe[]                    @relation("RecipeCreator")
  authorProfile              Author?                     @relation("UserAuthorProfile")
  createdAuthorRecords       Author[]                    @relation("AuthorCreatedBy")
  verifiedAuthorExpertises   Author[]                    @relation("AuthorExpertiseVerifier")
  validatedRecipeDietaryTags RecipeDietaryTag[]          @relation("RecipeDietaryTagValidator")
  createdRecipeMedia         RecipeMedia[]               @relation("RecipeMediaCreator")
  createdProductFavorites    ProductFavorite[]           @relation("ProductFavoriteCreator")
  createdRecipeFavorites     RecipeFavorite[]            @relation("RecipeFavoriteCreator")
  createdShoppingLists       ShoppingList[]              @relation("ShoppingListCreator")
  createdShoppingListItems   ShoppingListItem[]          @relation("ShoppingListItemCreator")
  cookingSessionsStarted     CookingSession[]            @relation("CookingSessionStarter")
  cookingSessionsCompleted   CookingSession[]            @relation("CookingSessionCompleter")
  recordedConsumptionEntries ConsumptionEntry[]          @relation("ConsumptionEntryRecorder")
  resolvedMealConsumptions   MealConsumptionResolution[] @relation("MealConsumptionResolver")
  cookingIngredientsResolved CookingSessionIngredient[]  @relation("CookingIngredientResolver")
  cookingStepsResolved       CookingSessionStep[]        @relation("CookingStepResolver")

  @@index([applicationRole])
  @@index([deletedAt])
  @@map("users")
}

model PersonProfile {
  id                 String         @id @default(uuid()) @db.Uuid
  userId             String?        @unique @map("user_id") @db.Uuid
  firstName          String         @map("first_name") @db.VarChar(100)
  lastName           String?        @map("last_name") @db.VarChar(100)
  birthDate          DateTime?      @map("birth_date") @db.Date
  biologicalSex      BiologicalSex? @map("biological_sex")
  avatarObjectPath   String?        @unique @map("avatar_object_path") @db.VarChar(1024)
  profileCompletedAt DateTime?      @map("profile_completed_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  archivedAt         DateTime?      @map("archived_at") @db.Timestamptz(3)

  user                User?                      @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  familyMembers       FamilyMember[]
  bodyMeasurements    BodyMeasurement[]
  activityPeriods     PersonActivityPeriod[]
  weightGoals         PersonWeightGoal[]
  nutrientTargetSets  NutrientTargetSet[]
  mealSetting         PersonMealSetting?
  dietaryRestrictions PersonDietaryRestriction[]
  allergies           PersonAllergy[]
  dislikedProducts    PersonDislikedProduct[]
  cuisinePreferences  PersonCuisinePreference[]

  @@index([archivedAt])
  @@map("person_profiles")
}

model BodyMeasurement {
  id              String                @id @default(uuid()) @db.Uuid
  personProfileId String                @map("person_profile_id") @db.Uuid
  weightKg        Decimal?              @map("weight_kg") @db.Decimal(6, 2)
  heightCm        Decimal?              @map("height_cm") @db.Decimal(5, 2)
  measuredAt      DateTime              @map("measured_at") @db.Timestamptz(3)
  source          BodyMeasurementSource @default(MANUAL)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  personProfile PersonProfile @relation(fields: [personProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  nutrientTargetSets    NutrientTargetSet[]
  weightGoalsAsBaseline PersonWeightGoal[]

  @@index([personProfileId, measuredAt(sort: Desc)])
  @@map("body_measurements")
}

model PersonActivityPeriod {
  id              String              @id @default(uuid()) @db.Uuid
  personProfileId String              @map("person_profile_id") @db.Uuid
  activityLevel   ActivityLevel       @map("activity_level")
  source          ActivityLevelSource @default(MANUAL)
  effectiveFrom   DateTime            @map("effective_from") @db.Timestamptz(3)
  effectiveTo     DateTime?           @map("effective_to") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  personProfile      PersonProfile       @relation(fields: [personProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  nutrientTargetSets NutrientTargetSet[]

  @@index([personProfileId, effectiveFrom(sort: Desc)])
  @@index([personProfileId, effectiveTo])
  @@map("person_activity_periods")
}

model PersonWeightGoal {
  id                    String           @id @default(uuid()) @db.Uuid
  personProfileId       String           @map("person_profile_id") @db.Uuid
  baselineMeasurementId String?          @map("baseline_measurement_id") @db.Uuid
  type                  WeightGoalType
  status                WeightGoalStatus @default(ACTIVE)
  source                WeightGoalSource @default(MANUAL)
  targetWeightKg        Decimal?         @map("target_weight_kg") @db.Decimal(6, 2)
  targetRateKgPerWeek   Decimal?         @map("target_rate_kg_per_week") @db.Decimal(4, 2)
  startsAt              DateTime         @default(now()) @map("starts_at") @db.Timestamptz(3)
  targetDate            DateTime?        @map("target_date") @db.Date
  endedAt               DateTime?        @map("ended_at") @db.Timestamptz(3)
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  personProfile       PersonProfile       @relation(fields: [personProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  baselineMeasurement BodyMeasurement?    @relation(fields: [baselineMeasurementId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  nutrientTargetSets  NutrientTargetSet[]

  @@index([personProfileId, startsAt(sort: Desc)])
  @@index([personProfileId, status])
  @@map("person_weight_goals")
}

model NutrientTargetSet {
  id                       String                  @id @default(uuid()) @db.Uuid
  personProfileId          String                  @map("person_profile_id") @db.Uuid
  bodyMeasurementId        String?                 @map("body_measurement_id") @db.Uuid
  activityPeriodId         String?                 @map("activity_period_id") @db.Uuid
  weightGoalId             String?                 @map("weight_goal_id") @db.Uuid
  source                   NutrientTargetSetSource
  calculationPolicyVersion String?                 @map("calculation_policy_version") @db.VarChar(100)
  effectiveFrom            DateTime                @default(now()) @map("effective_from") @db.Timestamptz(3)
  effectiveTo              DateTime?               @map("effective_to") @db.Timestamptz(3)
  createdAt                DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  personProfile   PersonProfile         @relation(fields: [personProfileId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  bodyMeasurement BodyMeasurement?      @relation(fields: [bodyMeasurementId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activityPeriod  PersonActivityPeriod? @relation(fields: [activityPeriodId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  weightGoal      PersonWeightGoal?     @relation(fields: [weightGoalId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  targets         NutrientTarget[]

  @@index([personProfileId, effectiveFrom(sort: Desc)])
  @@index([personProfileId, effectiveTo])
  @@index([bodyMeasurementId])
  @@index([activityPeriodId])
  @@index([weightGoalId])
  @@map("nutrient_target_sets")
}

model NutrientTarget {
  id           String               @id @default(uuid()) @db.Uuid
  targetSetId  String               @map("target_set_id") @db.Uuid
  nutrientId   String               @map("nutrient_id") @db.Uuid
  minimumValue Decimal?             @map("minimum_value") @db.Decimal(14, 4)
  targetValue  Decimal?             @map("target_value") @db.Decimal(14, 4)
  maximumValue Decimal?             @map("maximum_value") @db.Decimal(14, 4)
  source       NutrientTargetSource
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  targetSet NutrientTargetSet @relation(fields: [targetSetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  nutrient  Nutrient          @relation(fields: [nutrientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([targetSetId, nutrientId])
  @@index([nutrientId])
  @@map("nutrient_targets")
}

model PersonMealSetting {
  id              String   @id @default(uuid()) @db.Uuid
  personProfileId String   @unique @map("person_profile_id") @db.Uuid
  mainMealsPerDay Int      @default(3) @map("main_meals_per_day") @db.SmallInt
  snacksPerDay    Int      @default(0) @map("snacks_per_day") @db.SmallInt
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

