  @@index([shoppingListId, productCategoryId, status])
  @@index([productId, status])
  @@index([derivedMeasurementUnitId])
  @@index([requestedMeasurementUnitId])
  @@index([createdByUserId])
  @@map("shopping_list_items")
}

model ShoppingListItemSource {
  id                           String                         @id @default(uuid()) @db.Uuid
  shoppingListItemId           String                         @map("shopping_list_item_id") @db.Uuid
  kind                         ShoppingListItemSourceKind
  sourceKey                    String                         @map("source_key") @db.VarChar(128)
  sourceFingerprint            String                         @map("source_fingerprint") @db.Char(64)
  mealEntrySnapshotId          String                         @map("meal_entry_snapshot_id") @db.Uuid
  mealEntryId                  String?                        @map("meal_entry_id") @db.Uuid
  recipeIngredientSnapshotId   String?                        @map("recipe_ingredient_snapshot_id") @db.Uuid
  recipeIngredientId           String?                        @map("recipe_ingredient_id") @db.Uuid
  recipeSnapshotId             String?                        @map("recipe_snapshot_id") @db.Uuid
  recipeTitleSnapshot          String?                        @map("recipe_title_snapshot") @db.VarChar(300)
  mealDateSnapshot             DateTime                       @map("meal_date_snapshot") @db.Date
  productId                    String                         @map("product_id") @db.Uuid
  baseQuantity                 Decimal                        @map("base_quantity") @db.Decimal(20, 8)
  baseMeasurementUnitId        String                         @map("base_measurement_unit_id") @db.Uuid
  scaleFactor                  Decimal                        @map("scale_factor") @db.Decimal(18, 9)
  conversionKind               ShoppingListItemConversionKind @map("conversion_kind")
  conversionFactor             Decimal                        @map("conversion_factor") @db.Decimal(18, 9)
  contributedQuantity          Decimal                        @map("contributed_quantity") @db.Decimal(20, 8)
  contributedMeasurementUnitId String                         @map("contributed_measurement_unit_id") @db.Uuid
  calculationVersion           String                         @map("calculation_version") @db.VarChar(32)
  createdAt                    DateTime                       @default(now()) @map("created_at") @db.Timestamptz(3)

  shoppingListItem           ShoppingListItem  @relation(fields: [shoppingListItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mealEntry                  MealEntry?        @relation(fields: [mealEntryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  recipeIngredient           RecipeIngredient? @relation(fields: [recipeIngredientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  product                    Product           @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  baseMeasurementUnit        MeasurementUnit   @relation("ShoppingListItemSourceBaseUnit", fields: [baseMeasurementUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  contributedMeasurementUnit MeasurementUnit   @relation("ShoppingListItemSourceContributedUnit", fields: [contributedMeasurementUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)

