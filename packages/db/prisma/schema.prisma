}

//------------------ PRODUCTS --------------------------

model Product {
  id                       String                    @id @default(uuid()) @db.Uuid
  type                     ProductType
  nameEn                   String                    @map("name_en") @db.VarChar(240)
  nameUa                   String?                   @map("name_ua") @db.VarChar(240)
  gtin                     String?                   @unique @db.Char(14)
  categoryId               String                    @map("category_id") @db.Uuid
  brandId                  String?                   @map("brand_id") @db.Uuid
  defaultMeasurementUnitId String                    @map("default_measurement_unit_id") @db.Uuid
  baseProductId            String?                   @map("base_product_id") @db.Uuid
  foodState                ProductFoodState          @default(UNSPECIFIED) @map("food_state")
  ediblePortionPercent     Decimal?                  @map("edible_portion_percent") @db.Decimal(5, 2)
  status                   ProductStatus             @default(DRAFT)
  verificationStatus       ProductVerificationStatus @default(UNVERIFIED) @map("verification_status")
  notes                    String?                   @db.Text
  archivedAt               DateTime?                 @map("archived_at") @db.Timestamptz(3)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(3)

  category                  ProductCategory            @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brand                     Brand?                     @relation(fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  defaultMeasurementUnit    MeasurementUnit            @relation(fields: [defaultMeasurementUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  baseProduct               Product?                   @relation("BrandedProductBase", fields: [baseProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  brandedVariants           Product[]                  @relation("BrandedProductBase")
  cookingIngredientsPlanned CookingSessionIngredient[] @relation("CookingIngredientPlannedProduct")
  cookingIngredientsActual  CookingSessionIngredient[] @relation("CookingIngredientActualProduct")
  sourceReferences          ProductSourceReference[]
  nutrients                 ProductNutrient[]
  media                     ProductMedia[]
  dietaryTags               ProductDietaryTag[]
  allergens                 ProductAllergen[]
  portions                  ProductPortion[]
  recipeIngredients         RecipeIngredient[]
  mealEntries               MealEntry[]
  favorites                 ProductFavorite[]
  dislikedByProfiles        PersonDislikedProduct[]
  shoppingListItems         ShoppingListItem[]
  shoppingListItemSources   ShoppingListItemSource[]
  consumptionEntries        ConsumptionEntry[]

  @@index([categoryId, status])
  @@index([brandId, status])
  @@index([baseProductId])
  @@index([type, status])
  @@index([verificationStatus, status])
  @@index([foodState, status])
  @@index([nameEn])
  @@index([nameUa])
  @@map("products")
}

model ProductNutrient {
  productId                  String            @map("product_id") @db.Uuid
  nutrientId                 String            @map("nutrient_id") @db.Uuid
  valuePer100g               Decimal           @map("value_per_100g") @db.Decimal(20, 8)
  valueType                  NutrientValueType @default(UNKNOWN) @map("value_type")
  sourceReferenceId          String?           @map("source_reference_id") @db.Uuid
  sourceRowId                String?           @map("source_row_id") @db.VarChar(128)
  sourceNutrientExternalId   String?           @map("source_nutrient_external_id") @db.VarChar(64)
  sourceDerivationExternalId String?           @map("source_derivation_external_id") @db.VarChar(64)
  sourceDataPoints           Int?              @map("source_data_points")
  createdAt                  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  product         Product                 @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  nutrient        Nutrient                @relation(fields: [nutrientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceReference ProductSourceReference? @relation("ProductNutrientSource", fields: [sourceReferenceId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Cascade)

  @@id([productId, nutrientId])
  @@unique([sourceReferenceId, sourceRowId])
  @@index([nutrientId])
  @@index([sourceReferenceId])
  @@index([valueType])
  @@map("product_nutrients")
}

model ProductPortion {
  id                              String                   @id @default(uuid()) @db.Uuid
  productId                       String                   @map("product_id") @db.Uuid
  amount                          Decimal                  @db.Decimal(12, 4)
  gramWeight                      Decimal                  @map("gram_weight") @db.Decimal(12, 4)
  labelEn                         String                   @map("label_en") @db.VarChar(200)
  labelUa                         String?                  @map("label_ua") @db.VarChar(200)
  kind                            ProductPortionKind       @default(OTHER)
  weightType                      ProductPortionWeightType @default(UNKNOWN) @map("weight_type")
  measurementUnitId               String?                  @map("measurement_unit_id") @db.Uuid
  sourceReferenceId               String?                  @map("source_reference_id") @db.Uuid
  sourceRowId                     String?                  @map("source_row_id") @db.VarChar(128)
  sourceSequence                  Int?                     @map("source_sequence") @db.SmallInt
  sourceMeasurementUnitExternalId String?                  @map("source_measurement_unit_external_id") @db.VarChar(64)
  sourceDataPoints                Int?                     @map("source_data_points")
  isDefault                       Boolean                  @default(false) @map("is_default")
  isActive                        Boolean                  @default(true) @map("is_active")
  sortOrder                       Int                      @default(0) @map("sort_order") @db.SmallInt
  createdAt                       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  product           Product                 @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  measurementUnit   MeasurementUnit?        @relation(fields: [measurementUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceReference   ProductSourceReference? @relation("ProductPortionSource", fields: [sourceReferenceId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Cascade)
  recipeIngredients RecipeIngredient[]

  @@unique([sourceReferenceId, sourceRowId])
  @@index([productId, isActive, sortOrder])
  @@index([measurementUnitId])
  @@index([sourceReferenceId])
  @@index([kind])
  @@map("product_portions")
}

model ProductMedia {
  id                String             @id @default(uuid()) @db.Uuid
  productId         String             @map("product_id") @db.Uuid
  kind              ProductMediaKind
  status            ProductMediaStatus @default(PENDING)
  storageObjectPath String             @unique @map("storage_object_path") @db.VarChar(512)
  mimeType          String?            @map("mime_type") @db.VarChar(80)
  byteSize          BigInt?            @map("byte_size")
  widthPx           Int?               @map("width_px")
  heightPx          Int?               @map("height_px")
  checksumSha256    String?            @map("checksum_sha256") @db.Char(64)
