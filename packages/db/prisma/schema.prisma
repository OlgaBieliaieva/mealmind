model ShoppingList {
  id                String             @id @default(uuid()) @db.Uuid
  familyId          String             @map("family_id") @db.Uuid
  mealPlanId        String             @map("meal_plan_id") @db.Uuid
  periodStart       DateTime           @map("period_start") @db.Date
  periodEnd         DateTime           @map("period_end") @db.Date
  version           Int                @db.SmallInt
  revision          Int                @default(1)
  status            ShoppingListStatus @default(OPEN)
  sourceFingerprint String             @map("source_fingerprint") @db.Char(64)
  generatedAt       DateTime           @map("generated_at") @db.Timestamptz(3)
  createdByUserId   String?            @map("created_by_user_id") @db.Uuid
  completedAt       DateTime?          @map("completed_at") @db.Timestamptz(3)
  archivedAt        DateTime?          @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  family    Family             @relation(fields: [familyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  mealPlan  MealPlan           @relation(fields: [mealPlanId, familyId], references: [id, familyId], onDelete: Restrict, onUpdate: Cascade)
