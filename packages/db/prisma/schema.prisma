  product        Product @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  uploadedByUser User?   @relation("ProductMediaUploader", fields: [uploadedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([productId, status, sortOrder])
  @@index([productId, kind, status])
  @@index([uploadedByUserId])
  @@index([checksumSha256])
  @@map("product_media")
}

model ProductDietaryTag {
