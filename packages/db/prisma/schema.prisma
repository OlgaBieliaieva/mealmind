  productCategoryId          String?                @map("product_category_id") @db.Uuid
  derivedQuantity            Decimal?               @map("derived_quantity") @db.Decimal(12, 3)
  derivedMeasurementUnitId   String?                @map("derived_measurement_unit_id") @db.Uuid
  requestedQuantity          Decimal?               @map("requested_quantity") @db.Decimal(12, 3)
  requestedMeasurementUnitId String?                @map("requested_measurement_unit_id") @db.Uuid
  notes                      String?                @db.VarChar(1000)
  createdByUserId            String?                @map("created_by_user_id") @db.Uuid
  purchasedAt                DateTime?              @map("purchased_at") @db.Timestamptz(3)
  removedAt                  DateTime?              @map("removed_at") @db.Timestamptz(3)
  createdAt                  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                  DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  shoppingList             ShoppingList             @relation(fields: [shoppingListId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  product                  Product?                 @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  productCategory          ProductCategory?         @relation(fields: [productCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  derivedMeasurementUnit   MeasurementUnit?         @relation("ShoppingListItemDerivedUnit", fields: [derivedMeasurementUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  requestedMeasurementUnit MeasurementUnit?         @relation("ShoppingListItemRequestedUnit", fields: [requestedMeasurementUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdBy                User?                    @relation("ShoppingListItemCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
