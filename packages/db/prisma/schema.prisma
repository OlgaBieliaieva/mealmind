//------------------ COOKING --------------------------

model CookingSession {
  id                  String               @id @default(uuid()) @db.Uuid
  familyId            String               @map("family_id") @db.Uuid
  mealEntryId         String               @unique @map("meal_entry_id") @db.Uuid
  recipeId            String               @map("recipe_id") @db.Uuid
  startedByUserId     String               @map("started_by_user_id") @db.Uuid
  completedByUserId   String?              @map("completed_by_user_id") @db.Uuid
  status              CookingSessionStatus @default(IN_PROGRESS)
  revision            Int                  @default(0)
  recipeTitleSnapshot String               @map("recipe_title_snapshot") @db.VarChar(240)
  plannedYieldWeightG Decimal?             @map("planned_yield_weight_g") @db.Decimal(12, 3)
  actualYieldWeightG  Decimal?             @map("actual_yield_weight_g") @db.Decimal(12, 3)
  yieldBasis          CookingYieldBasis?   @map("yield_basis")
  startedAt           DateTime             @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime?            @map("completed_at") @db.Timestamptz(3)
  cancelledAt         DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  family             Family                     @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  mealEntry          MealEntry                  @relation(fields: [mealEntryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipe             Recipe                     @relation(fields: [recipeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  startedByUser      User                       @relation("CookingSessionStarter", fields: [startedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  completedByUser    User?                      @relation("CookingSessionCompleter", fields: [completedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  ingredients        CookingSessionIngredient[]
  steps              CookingSessionStep[]
  nutrients          CookingSessionNutrient[]
  consumptionEntries ConsumptionEntry[]

  @@unique([id, familyId])
  @@index([familyId, status, startedAt])
  @@index([recipeId])
  @@index([startedByUserId])
  @@index([completedByUserId])
  @@map("cooking_sessions")
}

model CookingSessionIngredient {
  id                        String                  @id @default(uuid()) @db.Uuid
  cookingSessionId          String                  @map("cooking_session_id") @db.Uuid
  recipeIngredientId        String?                 @map("recipe_ingredient_id") @db.Uuid
  position                  Int                     @db.SmallInt
  productNameSnapshot       String                  @map("product_name_snapshot") @db.VarChar(240)
  plannedProductId          String                  @map("planned_product_id") @db.Uuid
  plannedQuantity           Decimal                 @map("planned_quantity") @db.Decimal(12, 4)
  plannedMeasurementUnitId  String?                 @map("planned_measurement_unit_id") @db.Uuid
  plannedGramWeight         Decimal?                @map("planned_gram_weight") @db.Decimal(12, 4)
  status                    CookingIngredientStatus @default(PENDING)
  actualProductId           String?                 @map("actual_product_id") @db.Uuid
  actualProductNameSnapshot String?                 @map("actual_product_name_snapshot") @db.VarChar(240)
  actualQuantity            Decimal?                @map("actual_quantity") @db.Decimal(12, 4)
  actualMeasurementUnitId   String?                 @map("actual_measurement_unit_id") @db.Uuid
  actualGramWeight          Decimal?                @map("actual_gram_weight") @db.Decimal(12, 4)
  resolvedByUserId          String?                 @map("resolved_by_user_id") @db.Uuid
  resolvedAt                DateTime?               @map("resolved_at") @db.Timestamptz(3)
  createdAt                 DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  cookingSession         CookingSession    @relation(fields: [cookingSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipeIngredient       RecipeIngredient? @relation(fields: [recipeIngredientId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  plannedProduct         Product           @relation("CookingIngredientPlannedProduct", fields: [plannedProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  plannedMeasurementUnit MeasurementUnit?  @relation("CookingIngredientPlannedUnit", fields: [plannedMeasurementUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actualProduct          Product?          @relation("CookingIngredientActualProduct", fields: [actualProductId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  actualMeasurementUnit  MeasurementUnit?  @relation("CookingIngredientActualUnit", fields: [actualMeasurementUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  resolvedByUser         User?             @relation("CookingIngredientResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([cookingSessionId, position])
  @@unique([cookingSessionId, recipeIngredientId])
  @@index([plannedProductId])
  @@index([actualProductId])
  @@index([resolvedByUserId])
  @@map("cooking_session_ingredients")
}

model CookingSessionStep {
  id                   String            @id @default(uuid()) @db.Uuid
  cookingSessionId     String            @map("cooking_session_id") @db.Uuid
  recipeStepId         String?           @map("recipe_step_id") @db.Uuid
  position             Int               @db.SmallInt
  instructionSnapshot  String            @map("instruction_snapshot") @db.VarChar(4000)
  timerSecondsSnapshot Int?              @map("timer_seconds_snapshot")
  status               CookingStepStatus @default(PENDING)
  resolvedByUserId     String?           @map("resolved_by_user_id") @db.Uuid
  resolvedAt           DateTime?         @map("resolved_at") @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  cookingSession CookingSession @relation(fields: [cookingSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  recipeStep     RecipeStep?    @relation(fields: [recipeStepId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  resolvedByUser User?          @relation("CookingStepResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([cookingSessionId, position])
  @@unique([cookingSessionId, recipeStepId])
  @@index([resolvedByUserId])
  @@map("cooking_session_steps")
}

model CookingSessionNutrient {
  cookingSessionId  String                           @map("cooking_session_id") @db.Uuid
  nutrientId        String                           @map("nutrient_id") @db.Uuid
  valueTotal        Decimal                          @map("value_total") @db.Decimal(20, 8)
  calculationMethod CookingNutrientCalculationMethod @map("calculation_method")
  completeness      CookingNutrientCompleteness
  calculatorVersion String                           @map("calculator_version") @db.VarChar(64)
  calculatedAt      DateTime                         @map("calculated_at") @db.Timestamptz(3)
  createdAt         DateTime                         @default(now()) @map("created_at") @db.Timestamptz(3)

  cookingSession CookingSession @relation(fields: [cookingSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  nutrient       Nutrient       @relation(fields: [nutrientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([cookingSessionId, nutrientId])
  @@index([nutrientId])
  @@index([calculationMethod, completeness])
  @@map("cooking_session_nutrients")
}

//------------------ DIARY --------------------------

model ConsumptionEntry {
  id                           String                 @id @default(uuid()) @db.Uuid
  familyId                     String                 @map("family_id") @db.Uuid
  familyMemberId               String                 @map("family_member_id") @db.Uuid
  recordedByUserId             String                 @map("recorded_by_user_id") @db.Uuid
  source                       ConsumptionEntrySource
  sourceMealEntryParticipantId String?                @unique @map("source_meal_entry_participant_id") @db.Uuid
  productId                    String?                @map("product_id") @db.Uuid
  recipeId                     String?                @map("recipe_id") @db.Uuid
  quantity                     Decimal                @db.Decimal(12, 3)
  measurementUnitId            String                 @map("measurement_unit_id") @db.Uuid
  quantityInGrams              Decimal                @map("quantity_in_grams") @db.Decimal(12, 3)
  plannedQuantity              Decimal?               @map("planned_quantity") @db.Decimal(12, 3)
  plannedMeasurementUnitId     String?                @map("planned_measurement_unit_id") @db.Uuid
  plannedQuantityInGrams       Decimal?               @map("planned_quantity_in_grams") @db.Decimal(12, 3)
  cookingSessionId             String?                @map("cooking_session_id") @db.Uuid
  consumedAt                   DateTime               @map("consumed_at") @db.Timestamptz(3)
  localDate                    DateTime               @map("local_date") @db.Date
  timeZone                     String                 @map("time_zone") @db.VarChar(64)
  notes                        String?                @db.VarChar(1000)
  status                       ConsumptionEntryStatus @default(CONFIRMED)
  revision                     Int                    @default(0)
  voidedAt                     DateTime?              @map("voided_at") @db.Timestamptz(3)
  createdAt                    DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                    DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  family                     Family                     @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  familyMember               FamilyMember               @relation(fields: [familyMemberId, familyId], references: [id, familyId], onDelete: Restrict, onUpdate: Cascade)
  recordedByUser             User                       @relation("ConsumptionEntryRecorder", fields: [recordedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sourceMealEntryParticipant MealEntryParticipant?      @relation(fields: [sourceMealEntryParticipantId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  product                    Product?                   @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  recipe                     Recipe?                    @relation(fields: [recipeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  measurementUnit            MeasurementUnit            @relation("ConsumptionEntryActualUnit", fields: [measurementUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  cookingSession             CookingSession?            @relation(fields: [cookingSessionId, familyId], references: [id, familyId], onDelete: Restrict, onUpdate: Cascade)
  plannedMeasurementUnit     MeasurementUnit?           @relation("ConsumptionEntryPlannedUnit", fields: [plannedMeasurementUnitId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  nutrients                  ConsumptionEntryNutrient[]
  resolution                 MealConsumptionResolution?

  @@unique([id, familyId, familyMemberId])
  @@index([familyMemberId, localDate, status])
  @@index([familyId, localDate, status])
  @@index([recordedByUserId])
  @@index([productId])
  @@index([recipeId])
  @@index([measurementUnitId])
  @@index([plannedMeasurementUnitId])
  @@index([cookingSessionId])
  @@index([consumedAt])
  @@map("consumption_entries")
}

model ConsumptionEntryNutrient {
  consumptionEntryId String                               @map("consumption_entry_id") @db.Uuid
  nutrientId         String                               @map("nutrient_id") @db.Uuid
  value              Decimal                              @db.Decimal(20, 8)
  calculationMethod  ConsumptionNutrientCalculationMethod @map("calculation_method")
  completeness       ConsumptionNutrientCompleteness
  calculatorVersion  String                               @map("calculator_version") @db.VarChar(64)
  calculatedAt       DateTime                             @map("calculated_at") @db.Timestamptz(3)
  createdAt          DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)

  consumptionEntry ConsumptionEntry @relation(fields: [consumptionEntryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  nutrient         Nutrient         @relation(fields: [nutrientId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@id([consumptionEntryId, nutrientId])
  @@index([nutrientId])
  @@index([calculationMethod, completeness])
  @@index([calculatedAt])
  @@map("consumption_entry_nutrients")
}

model MealConsumptionResolution {
  id                     String                 @id @default(uuid()) @db.Uuid
  familyId               String                 @map("family_id") @db.Uuid
  familyMemberId         String                 @map("family_member_id") @db.Uuid
  mealEntryParticipantId String                 @unique @map("meal_entry_participant_id") @db.Uuid
  outcome                MealConsumptionOutcome
  consumptionEntryId     String?                @unique @map("consumption_entry_id") @db.Uuid
  resolvedByUserId       String                 @map("resolved_by_user_id") @db.Uuid
  resolvedAt             DateTime               @map("resolved_at") @db.Timestamptz(3)
  notes                  String?                @db.VarChar(500)
  createdAt              DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  family               Family               @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  familyMember         FamilyMember         @relation(fields: [familyMemberId, familyId], references: [id, familyId], onDelete: Restrict, onUpdate: Cascade)
  mealEntryParticipant MealEntryParticipant @relation(fields: [mealEntryParticipantId, familyMemberId], references: [id, familyMemberId], onDelete: Restrict, onUpdate: Cascade)
  consumptionEntry     ConsumptionEntry?    @relation(fields: [consumptionEntryId, familyId, familyMemberId], references: [id, familyId, familyMemberId], onDelete: Restrict, onUpdate: Cascade)
  resolvedByUser       User                 @relation("MealConsumptionResolver", fields: [resolvedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([mealEntryParticipantId, familyMemberId])
  @@unique([consumptionEntryId, familyId, familyMemberId])
  @@index([familyMemberId, resolvedAt])
  @@index([familyId, resolvedAt])
  @@index([resolvedByUserId])
  @@index([outcome])
  @@map("meal_consumption_resolutions")
}

//------------------ REFS --------------------------

model Allergen {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(64)
  nameUa    String   @map("name_ua") @db.VarChar(160)
  nameEn    String   @map("name_en") @db.VarChar(160)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  personAllergies  PersonAllergy[]
  productAllergens ProductAllergen[]

  @@index([isActive])
  @@map("allergens")
}

model Nutrient {
  id                 String               @id @default(uuid()) @db.Uuid
  code               String               @unique @db.VarChar(64)
  nameUa             String               @map("name_ua") @db.VarChar(160)
  nameEn             String               @map("name_en") @db.VarChar(160)
  group              NutrientGroup
  unit               NutrientUnit
  displayLevel       NutrientDisplayLevel @default(EXTENDED) @map("display_level")
  isTargetable       Boolean              @default(false) @map("is_targetable")
  sortOrder          Int                  @map("sort_order")
  usdaNutrientId     Int?                 @unique @map("usda_nutrient_id")
  usdaNutrientNumber String?              @unique @map("usda_nutrient_number") @db.VarChar(32)
  isActive           Boolean              @default(true) @map("is_active")
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  productValues           ProductNutrient[]
  recipeValues            RecipeNutrient[]
  targets                 NutrientTarget[]
  cookingSessionNutrients CookingSessionNutrient[]
  consumptionValues       ConsumptionEntryNutrient[]

  @@index([isActive, displayLevel, sortOrder])
  @@index([group])
  @@map("nutrients")
}

model MeasurementUnit {
  id               String               @id @default(uuid()) @db.Uuid
  code             String               @unique @db.VarChar(32)
  symbol           String               @unique @db.VarChar(16)
  nameUa           String               @map("name_ua") @db.VarChar(80)
  nameEn           String               @map("name_en") @db.VarChar(80)
  dimension        MeasurementDimension
  factorToBaseUnit Decimal              @map("factor_to_base_unit") @db.Decimal(18, 9)
  isBaseUnit       Boolean              @default(false) @map("is_base_unit")
  isActive         Boolean              @default(true) @map("is_active")
  sortOrder        Int                  @map("sort_order") @db.SmallInt
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  products                           Product[]
  productPortions                    ProductPortion[]
  recipeIngredients                  RecipeIngredient[]
  mealEntryParticipants              MealEntryParticipant[]
  derivedShoppingListItems           ShoppingListItem[]         @relation("ShoppingListItemDerivedUnit")
  requestedShoppingListItems         ShoppingListItem[]         @relation("ShoppingListItemRequestedUnit")
  baseShoppingListItemSources        ShoppingListItemSource[]   @relation("ShoppingListItemSourceBaseUnit")
  contributedShoppingListItemSources ShoppingListItemSource[]   @relation("ShoppingListItemSourceContributedUnit")
  actualConsumptionEntries           ConsumptionEntry[]         @relation("ConsumptionEntryActualUnit")
  plannedConsumptionEntries          ConsumptionEntry[]         @relation("ConsumptionEntryPlannedUnit")
  cookingIngredientsPlanned          CookingSessionIngredient[] @relation("CookingIngredientPlannedUnit")
  cookingIngredientsActual           CookingSessionIngredient[] @relation("CookingIngredientActualUnit")

  @@index([dimension, isActive, sortOrder])
  @@map("measurement_units")
}

model DietaryTag {
  id                      String         @id @default(uuid()) @db.Uuid
  code                    String         @unique @db.VarChar(64)
  nameUa                  String         @map("name_ua") @db.VarChar(120)
  nameEn                  String         @map("name_en") @db.VarChar(120)
  kind                    DietaryTagKind
  isRestrictionSelectable Boolean        @default(false) @map("is_restriction_selectable")
  isActive                Boolean        @default(true) @map("is_active")
  sortOrder               Int            @map("sort_order") @db.SmallInt
  createdAt               DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  personRestrictions PersonDietaryRestriction[]
  recipeLinks        RecipeDietaryTag[]
  productLinks       ProductDietaryTag[]

  @@index([kind, isActive, sortOrder])
  @@index([isRestrictionSelectable, isActive, sortOrder])
  @@map("dietary_tags")
}

model Cuisine {
  id                     String       @id @default(uuid()) @db.Uuid
  code                   String       @unique @db.VarChar(64)
  nameUa                 String       @map("name_ua") @db.VarChar(120)
  nameEn                 String       @map("name_en") @db.VarChar(120)
  scope                  CuisineScope
  isPreferenceSelectable Boolean      @default(true) @map("is_preference_selectable")
  isActive               Boolean      @default(true) @map("is_active")
  sortOrder              Int          @map("sort_order") @db.SmallInt
  createdAt              DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  personPreferences PersonCuisinePreference[]
  recipeLinks       RecipeCuisine[]

  @@index([scope, isActive, sortOrder])
  @@index([isPreferenceSelectable, isActive, sortOrder])
  @@map("cuisines")
}

model ProductCategory {
  id               String              @id @default(uuid()) @db.Uuid
  code             String              @unique @db.VarChar(80)
  nameUa           String              @map("name_ua") @db.VarChar(160)
  nameEn           String              @map("name_en") @db.VarChar(160)
  kind             ProductCategoryKind
  parentCategoryId String?             @map("parent_category_id") @db.Uuid
  isAssignable     Boolean             @default(true) @map("is_assignable")
  isActive         Boolean             @default(true) @map("is_active")
  sortOrder        Int                 @map("sort_order") @db.SmallInt
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  parentCategory    ProductCategory?   @relation("ProductCategoryTree", fields: [parentCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children          ProductCategory[]  @relation("ProductCategoryTree")
  products          Product[]
  shoppingListItems ShoppingListItem[]

  @@index([parentCategoryId, isActive, sortOrder])
  @@index([kind, isActive])
  @@map("product_categories")
}

model Brand {
  id                 String                  @id @default(uuid()) @db.Uuid
  name               String                  @db.VarChar(160)
  nameUa             String?                 @map("name_ua") @db.VarChar(160)
  nameEn             String?                 @map("name_en") @db.VarChar(160)
  countryCode        String?                 @map("country_code") @db.Char(2)
  websiteUrl         String?                 @map("website_url") @db.VarChar(2048)
  status             BrandStatus             @default(DRAFT)
  verificationStatus BrandVerificationStatus @default(UNVERIFIED) @map("verification_status")
  notes              String?                 @db.Text
  archivedAt         DateTime?               @map("archived_at") @db.Timestamptz(3)
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  products Product[]

  @@index([status, name])
  @@index([verificationStatus, status])
  @@index([countryCode, status])
  @@map("brands")
}

model ProductSourceReference {
  id              String                @id @default(uuid()) @db.Uuid
  productId       String                @map("product_id") @db.Uuid
  provider        ProductSourceProvider
  dataset         ProductSourceDataset
  externalId      String                @map("external_id") @db.VarChar(128)
  sourceRelease   DateTime              @map("source_release") @db.Date
  publicationDate DateTime?             @map("publication_date") @db.Date
  isPrimary       Boolean               @default(false) @map("is_primary")
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  nutrientValues     ProductNutrient[]   @relation("ProductNutrientSource")
  productPortions    ProductPortion[]    @relation("ProductPortionSource")
  productDietaryTags ProductDietaryTag[] @relation("ProductDietaryTagSource")
  productAllergens   ProductAllergen[]   @relation("ProductAllergenSource")

  @@unique([provider, dataset, externalId])
  @@unique([id, productId])
  @@index([productId, isPrimary])
  @@map("product_source_references")
}

model RecipeType {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(64)
  nameUa    String   @map("name_ua") @db.VarChar(120)
  nameEn    String   @map("name_en") @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @map("sort_order") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipes Recipe[]

  @@index([isActive, sortOrder])
  @@map("recipe_types")
}

model MealType {
  id        String       @id @default(uuid()) @db.Uuid
  code      String       @unique @db.VarChar(64)
  nameUa    String       @map("name_ua") @db.VarChar(120)
  nameEn    String       @map("name_en") @db.VarChar(120)
  kind      MealTypeKind
  isActive  Boolean      @default(true) @map("is_active")
  sortOrder Int          @map("sort_order") @db.SmallInt
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  mealEntries MealEntry[]

  @@index([kind, isActive, sortOrder])
  @@map("meal_types")
}
