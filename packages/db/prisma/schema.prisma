  @@index([createdByUserId])
  @@map("product_favorites")
}

//------------------ RECIPES --------------------------

model Recipe {
  id               String            @id @default(uuid()) @db.Uuid
  title            String            @db.VarChar(240)
  summary          String?           @db.VarChar(500)
  description      String?           @db.Text
  status           RecipeStatus      @default(DRAFT)
  visibility       RecipeVisibility
  difficulty       RecipeDifficulty?
  recipeTypeId     String?           @map("recipe_type_id") @db.Uuid
  familyId         String?           @map("family_id") @db.Uuid
  authorId         String?           @map("author_id") @db.Uuid
  createdByUserId  String?           @map("created_by_user_id") @db.Uuid
  baseServings     Int?              @map("base_servings") @db.SmallInt
  yieldWeightG     Decimal?          @map("yield_weight_g") @db.Decimal(12, 3)
  prepTimeMin      Int?              @map("prep_time_min") @db.SmallInt
  cookTimeMin      Int?              @map("cook_time_min") @db.SmallInt
  restTimeMin      Int?              @map("rest_time_min") @db.SmallInt
  originalRecipeId String?           @map("original_recipe_id") @db.Uuid
  publishedAt      DateTime?         @map("published_at") @db.Timestamptz(3)
  archivedAt       DateTime?         @map("archived_at") @db.Timestamptz(3)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipeType     RecipeType? @relation(fields: [recipeTypeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  family         Family?     @relation(fields: [familyId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  author         Author?     @relation(fields: [authorId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdByUser  User?       @relation("RecipeCreator", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  originalRecipe Recipe?     @relation("RecipeDerivation", fields: [originalRecipeId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  derivedRecipes Recipe[]    @relation("RecipeDerivation")

  ingredients        RecipeIngredient[]
  steps              RecipeStep[]
  sources            RecipeSource[]
  cuisines           RecipeCuisine[]
  dietaryTags        RecipeDietaryTag[]
  nutrients          RecipeNutrient[]
  media              RecipeMedia[]
  mealEntries        MealEntry[]
  favorites          RecipeFavorite[]
  cookingSessions    CookingSession[]
  consumptionEntries ConsumptionEntry[]

  @@index([status, visibility, updatedAt])
  @@index([recipeTypeId, status])
  @@index([familyId, status, updatedAt])
  @@index([authorId, status])
  @@index([createdByUserId])
  @@index([originalRecipeId])
  @@index([title])
  @@map("recipes")
}

model Author {
  id                        String         @id @default(uuid()) @db.Uuid
  type                      AuthorType
  expertiseArea             ExpertiseArea? @map("expertise_area")
  slug                      String         @unique @db.VarChar(180)
  displayName               String         @map("display_name") @db.VarChar(160)
  bio                       String?        @db.Text
  avatarObjectPath          String?        @map("avatar_object_path") @db.VarChar(500)
  userId                    String?        @unique @map("user_id") @db.Uuid
  createdByUserId           String?        @map("created_by_user_id") @db.Uuid
  expertiseVerifiedByUserId String?        @map("expertise_verified_by_user_id") @db.Uuid
  expertiseVerifiedAt       DateTime?      @map("expertise_verified_at") @db.Timestamptz(3)
  archivedAt                DateTime?      @map("archived_at") @db.Timestamptz(3)
  createdAt                 DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                 DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  user                User? @relation("UserAuthorProfile", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  createdByUser       User? @relation("AuthorCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  expertiseVerifiedBy User? @relation("AuthorExpertiseVerifier", fields: [expertiseVerifiedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  recipes Recipe[]
  media   RecipeMedia[]
  links   AuthorLink[]

  @@index([type, archivedAt])
  @@index([expertiseArea, archivedAt])
  @@index([displayName])
  @@index([createdByUserId])
  @@index([expertiseVerifiedByUserId])
  @@map("authors")
}

model AuthorLink {
  id        String         @id @default(uuid()) @db.Uuid
  authorId  String         @map("author_id") @db.Uuid
  type      AuthorLinkType
  url       String         @db.VarChar(2048)
  position  Int            @db.SmallInt
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  author Author @relation(fields: [authorId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([authorId, url])
  @@unique([authorId, position])
  @@index([authorId, type])
  @@map("author_links")
}

model RecipeIngredient {
  id                String                      @id @default(uuid()) @db.Uuid
  recipeId          String                      @map("recipe_id") @db.Uuid
  productId         String                      @map("product_id") @db.Uuid
  quantity          Decimal                     @db.Decimal(12, 4)
  measurementUnitId String?                     @map("measurement_unit_id") @db.Uuid
  productPortionId  String?                     @map("product_portion_id") @db.Uuid
  gramWeight        Decimal?                    @map("gram_weight") @db.Decimal(12, 4)
  conversionMethod  IngredientConversionMethod? @map("conversion_method")
  isOptional        Boolean                     @default(false) @map("is_optional")
