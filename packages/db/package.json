{
  "name": "@mealmind/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "prisma generate",
    "build": "npm run generate && tsc",
    "typecheck": "npm run generate && tsc --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:seeds": "npm run generate && tsc -p tsconfig.seed.json --noEmit",
    "typecheck:db-tests": "npm run generate && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:seed:reference": "npm run generate && prisma db seed",
    "db:test:migrations": "npm run generate && tsx prisma/tests/migration-smoke.ts",
    "db:test:seed": "npm run generate && tsx prisma/tests/reference-seed-idempotency.ts",
    "db:test": "npm run db:test:migrations && npm run db:test:seed",
    "usda": "tsx scripts/usda/src/index.ts",
    "usda:typecheck": "tsc --project scripts/usda/tsconfig.json",
    "usda:check": "tsx scripts/usda/src/index.ts check",
    "usda:test": "tsx --test scripts/usda/src/**/*.test.ts",
    "usda:select": "tsx scripts/usda/src/index.ts select",
    "usda:normalize": "tsx scripts/usda/src/index.ts normalize",
    "usda:review": "tsx scripts/usda/src/index.ts review",
    "usda:curate": "tsx scripts/usda/src/index.ts curate",
    "usda:curate:strict": "tsx scripts/usda/src/index.ts curate --strict"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "csv-parse": "^7.0.2",
    "pg": "8.22.0",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "8.20.0",
    "dotenv": "17.4.2",
    "prisma": "7.9.1",
    "tsx": "^4.23.1"
  }
}
