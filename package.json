{
  "name": "mealmind",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "next": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run api:openapi:check && npm run test:ui-quality && npm run test:coverage && npm run build",
    "audit": "npm audit --omit=dev --audit-level=moderate",
    "audit:all": "npm audit --audit-level=moderate",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run api:openapi:check && npm run test:ui-quality && npm run test:coverage",
    "supabase:start": "supabase start",
    "supabase:status": "supabase status",
    "supabase:stop": "supabase stop",
    "db:ready": "supabase status",
    "db:generate": "npm run generate -w @mealmind/db",
    "db:format": "npm run db:format -w @mealmind/db",
    "db:validate": "npm run db:validate -w @mealmind/db",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @mealmind/db",
    "db:migrate:status": "npm run db:migrate:status -w @mealmind/db",
    "db:seed:reference": "npm run db:seed:reference -w @mealmind/db",
    "db:test:migrations": "npm run db:test:migrations -w @mealmind/db",
    "db:test:seed": "npm run db:test:seed -w @mealmind/db",
    "db:test": "npm run db:test -w @mealmind/db",
    "api:openapi:export": "npm run openapi:export -w @mealmind/api",
    "api:openapi:check": "npm run openapi:check -w @mealmind/api",
    "api:openapi:watch": "npm run openapi:watch -w @mealmind/api",
    "test:ui-quality": "turbo run test:ui-quality"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@vitest/coverage-v8": "4.1.10",
    "axe-core": "4.12.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "globals": "17.7.0",
    "html-validate": "11.5.6",
    "prettier": "3.9.6",
    "supabase": "2.109.1",
    "turbo": "2.10.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.35.3": true,
    "unrs-resolver@1.12.2": true,
    "prisma@7.9.1": true,
    "@prisma/engines@7.9.1": true
  }
}
